# Data Source Configuration
# Use 'csv' to read from data/sales_data.csv (default)
# Use 'supabase' to read from a Supabase table
DATA_SOURCE=csv

# Supabase Credentials (Required if DATA_SOURCE=supabase)
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Sheets Integration (Required if DATA_SOURCE=google_sheets)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/.../exec

# AI Insights (Required for AI features)
GEMINI_API_KEY=your-gemini-api-key

